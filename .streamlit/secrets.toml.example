# Copy to .streamlit/secrets.toml on the Python server, or use the corresponding
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY environment variables.
# Run sql/reviews.sql in the Supabase SQL editor first.
# Never commit the real secrets file or expose this key in browser-side code.
[reviews]
url = "https://YOUR_PROJECT.supabase.co"
service_role_key = "YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Optional: enable Places API (New) in a billed Google Maps Platform project.
# Only needed to look up store coordinates automatically; browser GPS and pasted
# Google Maps coordinates work without this key. Never expose the key in JS.
# [google_maps]
# api_key = "YOUR_SERVER_ONLY_GOOGLE_PLACES_API_KEY"
